{
  "name": "bigskyroi",
  "main": "workers/site.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bigskyroi.com", "custom_domain": true },
    { "pattern": "www.bigskyroi.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
