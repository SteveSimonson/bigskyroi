{
  "name": "bigskyroi",
  "main": "workers/site.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Apex already has Cloudflare DNS, so it stays a zone route.
  // www had no public record. A custom domain creates that record and
  // the worker 301s it to the apex.
  "routes": [
    { "pattern": "bigskyroi.com/*", "zone_name": "bigskyroi.com" },
    { "pattern": "bigskyroi.com", "zone_name": "bigskyroi.com" },
    { "pattern": "www.bigskyroi.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
